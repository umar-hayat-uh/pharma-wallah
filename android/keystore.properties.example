# Copy to android/keystore.properties and fill in. That file is gitignored —
# NEVER commit it, and never commit the .jks/.keystore file either.
#
# Create the key once (and back it up somewhere safe — losing it means you can
# never ship an update that upgrades an existing install):
#
#   keytool -genkey -v -keystore ~/pharmawallah-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias pharmawallah
#
storeFile=/absolute/path/to/pharmawallah-release.jks
storePassword=CHANGE_ME
keyAlias=pharmawallah
keyPassword=CHANGE_ME
