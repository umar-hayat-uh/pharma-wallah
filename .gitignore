# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/.env
.env
.clerk/
wget-log

# android app (Capacitor) — build output and generated route tree.
# The calculators themselves live in src/; mobile/app/calculation-tools/<slug>/
# and mobile/app/_generated/ are re-emitted by scripts/generate-mobile-routes.mjs
# on every `npm run mobile:build`, so they are not tracked.
/mobile/.next/
/mobile/out/
/mobile/next-env.d.ts
/mobile/app/_generated/
/mobile/app/calculation-tools/*/

# android signing — keys and passwords must never be committed
android/keystore.properties
*.jks
*.keystore

# iOS app (Capacitor) — the native project IS committed (like android/); only
# the copied web bundle and generated configs are not. Those are covered by
# ios/.gitignore, which Capacitor's template writes.

# Brand .ttf files fetched by scripts/generate-ios-assets.mjs. The generated
# PNGs are committed, so nobody needs these unless the brand changes.
/scripts/.fonts/

# Windows desktop app (Tauri 2) — build output and generated route tree.
# The calculators themselves live in src/; desktop/app/calculation-tools/<slug>/
# and desktop/app/_generated/ are re-emitted by
# scripts/generate-desktop-routes.mjs on every `npm run desktop:build`.
/desktop/.next/
/desktop/out/
/desktop/next-env.d.ts
/desktop/app/_generated/
/desktop/app/calculation-tools/*/

# Rust build artefacts. src-tauri/ itself IS committed (config, Rust source,
# icons); target/ is hundreds of MB of compiler output.
/src-tauri/target/
/src-tauri/gen/
