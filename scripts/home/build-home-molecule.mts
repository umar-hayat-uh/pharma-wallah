/*
 * Writes the home page's flying molecule:
 *   node scripts/home/build-home-molecule.mts
 *   -> src/components/Home/molecule-landing/molecule-data.ts
 *
 * Paracetamol from the Molecular Lab's PubChem-verified library entry, given 3D
 * coordinates by the lab's own generateConformer (OpenChemLib conformer +
 * MMFF94s+). Precomputed so the home page never loads OpenChemLib (CLAUDE.md
 * §6 rule 18): it ships ~2 KB of numbers and draws them with plain three.js.
 */
import { register } from "node:module";
import { writeFile } from "node:fs/promises";

register("../lib/ts-resolve.mjs", import.meta.url);

const OCL = await import("openchemlib");
// The conformer generator needs its torsion library, as in scripts/molecular-lab.test.mts.
OCL.Resources.registerFromNodejs();
const core = await import("../../src/components/molecular-lab/chem-core.ts");
const { LIBRARY } = await import("../../src/components/molecular-lab/library-data.ts");

const entry = LIBRARY.find((e: { id: string }) => e.id === "paracetamol");
if (!entry) throw new Error("paracetamol missing from the Molecular Lab library");

const { graph } = core.fromSmiles(OCL, entry.smiles);
const { conformer, minimised } = core.generateConformer(OCL, graph, 42);
if (!minimised) throw new Error("MMFF94s+ did not converge — refusing to ship an unminimised geometry");

// Centre on the heavy atoms, round to 0.001 Å (far below what the page can show).
const heavy = conformer.atoms.filter((a: { el: string }) => a.el !== "H");
const c = ["x", "y", "z"].map((k) => heavy.reduce((s: number, a: { pos: Record<string, number> }) => s + a.pos[k], 0) / heavy.length);
const r = (v: number) => Math.round(v * 1000) / 1000;
const atoms = conformer.atoms.map((a: { el: string; pos: { x: number; y: number; z: number } }) => [a.el, r(a.pos.x - c[0]), r(a.pos.y - c[1]), r(a.pos.z - c[2])]);
const bonds = conformer.bonds.map((b: { a: number; b: number; order: number }) => [b.a, b.b, b.order]);

const out = `/*
 * GENERATED by scripts/home/build-home-molecule.mts — do not edit by hand.
 * ${entry.name} (${entry.formula}, PubChem CID ${entry.cid}), SMILES ${entry.smiles}.
 * 3D: OpenChemLib conformer (seed 42) + MMFF94s+ minimisation, coordinates in Å,
 * centred on the heavy atoms. Bond orders are Kekulé (the ring alternates 1/2).
 */
export const MOLECULE = {
  name: ${JSON.stringify(entry.name)},
  formula: ${JSON.stringify(entry.formula)},
  cid: ${entry.cid},
  atoms: ${JSON.stringify(atoms)} as [string, number, number, number][],
  bonds: ${JSON.stringify(bonds)} as [number, number, number][],
};
`;
const file = new URL("../../src/components/Home/molecule-landing/molecule-data.ts", import.meta.url);
await writeFile(file, out);
console.log(`${entry.name}: ${atoms.length} atoms, ${bonds.length} bonds -> ${file.pathname}`);
